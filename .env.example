# Copy to .env.local for local development. Never commit real credentials.
# Firebase client configuration is public by design. Keep it separate from the
# server-only service account below.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin credentials. Literal \n sequences are accepted in
# FIREBASE_PRIVATE_KEY so the value can stay on one line.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Human sessions. TRAINEE_SESSION_SECRET is obsolete and must not be set.
TRAINEE_SESSION_MAX_AGE_SECONDS=432000
APP_ORIGIN=
TRUST_PROXY_HEADERS=false

# Machine authentication. CRON_SECRET is sent by Vercel Cron. CF_SYNC_SECRET is
# an optional alternative for a separately managed scheduler.
CRON_SECRET=
CF_SYNC_SECRET=
POINTS_EVENT_SECRET=

# Temporary migration claim flow. Leave disabled unless a bounded migration is
# actively in progress, and remove these variables afterwards.
TRAINEE_LEGACY_CLAIM_ENABLED=false
TRAINEE_LEGACY_CLAIM_DEADLINE=
TRAINEE_CLAIM_SECRET=

# Codeforces synchronization
CODEFORCES_SYNC_INTERVAL_HOURS=6
CODEFORCES_SYNC_BATCH_SIZE=10
CODEFORCES_SYNC_SCAN_LIMIT=500
CODEFORCES_SYNC_TIME_BUDGET_MS=45000
CODEFORCES_SYNC_MIN_ATTEMPT_MS=20000
CODEFORCES_CRON_MAX_DURATION_SECONDS=60
CODEFORCES_MIN_INTERVAL_MS=2000
CODEFORCES_RATE_LIMIT_MAX_WAIT_MS=120000
CODEFORCES_REQUEST_TIMEOUT_MS=15000
CODEFORCES_MAX_RETRIES=2
CODEFORCES_RETRY_BASE_MS=500
CODEFORCES_MANUAL_COOLDOWN_MS=30000
CODEFORCES_SYNC_LOCK_TTL_MS=120000
CODEFORCES_LOCK_HEARTBEAT_MS=
CODEFORCES_LOCK_ACQUIRE_RETRIES=3
CODEFORCES_LOCK_RETRY_BASE_MS=100
CODEFORCES_RETRY_DELAY_MS=3600000
CODEFORCES_MAX_STATUS_PAGES=10
CODEFORCES_MAX_RESPONSE_BYTES=12000000

# Optional Supabase referral configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opt in to strict production validation outside Vercel.
REQUIRE_PRODUCTION_CONFIG=false

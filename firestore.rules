rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // This application has no client-side Firestore SDK. Every read and write
    // goes through server-only Next.js route handlers using the Admin SDK,
    // which bypasses these rules. Direct client access is therefore denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
